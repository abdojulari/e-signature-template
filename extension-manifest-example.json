{
  "manifest_version": 3,
  "name": "SignaturePro - Email Signature Manager",
  "version": "1.0.0",
  "description": "Beautiful email signature generator with glassmorphism effects. Install signatures directly in Gmail, Outlook, and other email clients.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "*://outlook.live.com/*",
    "*://outlook.office.com/*",
    "*://mail.yahoo.com/*",
    "*://mail.aol.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SignaturePro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://mail.yahoo.com/*",
        "*://mail.aol.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "author": "SignaturePro Team",
  "homepage_url": "https://signaturepro.com",
  "short_name": "SignaturePro"
} 